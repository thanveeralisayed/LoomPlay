<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit user-initiated LAN / NAS cleartext HTTP streams (e.g. 192.168.x.x) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

